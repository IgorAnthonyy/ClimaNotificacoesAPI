# ===========================================
# ClimaNotificacoesAPI - Environment Variables
# ===========================================

# Database Configuration
# Strong password required for SQL Server (must contain uppercase, lowercase, numbers, and special characters)
PASSWORD_SQL=YourStr0ng!Password#2024

# Email Configuration (for sending weather alerts)
# Use your email provider credentials (Gmail, Outlook, etc.)
EMAIL_USERNAME=seu@email.com
EMAIL_PASSWORD=suaSenhaDeEmail

# JWT Secret Key
# Generate a strong random key for production (minimum 32 characters recommended)
JWT_SECRET_KEY=sua-chave-super-secreta-minima-32-caracteres-para-producao-segura

# OpenWeatherMap API Key
# Get your free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=sua-api-key-do-openweathermap
